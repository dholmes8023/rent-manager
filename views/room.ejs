<%- include('partials/top', { title: `Phòng ${room.name}`, active: 'rooms' }) %>
<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <a href="/" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium mb-1 inline-flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Về danh sách
    </a>
    <h1 class="text-3xl font-bold text-slate-900 tracking-tight mt-1">Phòng <%= room.name %></h1>
  </div>
  <% if (hasCompleteMeter) { %>
    <a class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-sm shadow-indigo-200 transition-colors" href="/rooms/<%= room.id %>/invoice/<%= yyyymm %>">Xem Hoá đơn tháng này</a>
  <% } %>
</div>

<div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm mb-8">
  <div class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-3 px-1">Chuyển nhanh sang phòng khác</div>
  <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-2">
    <% allRooms.forEach(rm => { %>
      <% const active = rm.id === room.id; %>
      <a href="/rooms/<%= rm.id %>?yyyymm=<%= yyyymm %>"
         class="relative flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl text-sm font-semibold border transition-colors <%= active ? 'bg-indigo-600 text-white border-indigo-600 shadow-sm shadow-indigo-200 cursor-default' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-indigo-300 hover:bg-indigo-50' %>"
         <%= active ? 'aria-current="page"' : '' %>>
        <span class="w-1.5 h-1.5 rounded-full <%= rm.occupied ? 'bg-emerald-500' : 'bg-amber-400' %> <%= active ? 'ring-2 ring-white/40' : '' %>"></span>
        <%= rm.name %>
      </a>
    <% }) %>
  </div>
</div>

<div class="grid lg:grid-cols-2 gap-8">
  <div class="space-y-8">
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-lg font-bold text-slate-900">Thông tin chung</h2>
        <a href="/rooms/<%= room.id %>/edit" class="text-sm px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-600 font-medium transition-colors">Sửa phòng</a>
      </div>
      
      <div class="grid grid-cols-2 gap-4 text-sm mb-6">
        <div class="col-span-2 sm:col-span-1 p-3 rounded-xl bg-slate-50 border border-slate-100">
          <div class="text-slate-500 mb-1">Trạng thái</div>
          <% if (tenant) { %>
            <div class="font-semibold text-emerald-700 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500"></span>Đã có người</div>
          <% } else { %>
            <div class="font-semibold text-amber-700 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-amber-500"></span>Phòng trống</div>
          <% } %>
        </div>
        <div class="col-span-2 sm:col-span-1 p-3 rounded-xl bg-slate-50 border border-slate-100">
          <div class="text-slate-500 mb-1">Người thuê</div>
          <div class="font-semibold text-slate-800"><%= tenant?.full_name || "—" %></div>
          <% if(tenant?.phone) { %><div class="text-xs text-slate-500 mt-0.5"><%= tenant.phone %></div><% } %>
        </div>
      </div>

      <div class="space-y-3 text-sm">
        <div class="flex justify-between items-center py-2 border-b border-slate-100">
          <span class="text-slate-500">Tiền phòng / tháng</span>
          <span class="font-bold text-slate-900 num"><%= tariff.rent %></span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-slate-100">
          <span class="text-slate-500">Mạng / tháng</span>
          <span class="font-bold text-slate-900 num"><%= tariff.internet_fee %></span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-slate-100">
          <span class="text-slate-500">Vệ sinh <span class="text-xs text-slate-400">(<%= tariff.people %> người × <%= Number(cleaningPerPerson).toLocaleString('vi-VN') %>)</span></span>
          <span class="font-bold text-slate-900 num"><%= tariff.cleaning_fee %></span>
        </div>
        <div class="flex justify-between items-center gap-4 py-2 border-b border-slate-100">
          <div>
            <div class="text-slate-500">Số tháng thu</div>
            <div class="text-xs text-slate-400 mt-0.5">Phí phòng, mạng và vệ sinh sẽ nhân theo số tháng</div>
          </div>
          <form method="POST" action="/rooms/<%= room.id %>/months?yyyymm=<%= yyyymm %>" class="flex items-center gap-2 shrink-0">
            <label for="months" class="sr-only">Số tháng thu</label>
            <input id="months" type="number" name="months" min="1" step="1" required value="<%= tariff.months || 1 %>" class="input w-20 text-center font-semibold" />
            <span class="text-sm text-slate-500">tháng</span>
            <button type="submit" class="px-3 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold transition-colors">Lưu</button>
          </form>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-slate-100">
          <span class="text-slate-500">Đơn giá điện</span>
          <span class="font-bold text-slate-900"><span class="num"><%= tariff.electricity_price %></span> / kWh</span>
        </div>
        <div class="flex justify-between items-center py-2">
          <span class="text-slate-500">Đơn giá nước</span>
          <span class="font-bold text-slate-900"><span class="num"><%= tariff.water_price %></span> / m³</span>
        </div>
      </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
      <h3 class="text-lg font-bold text-slate-900 mb-4">Quản lý người thuê</h3>
      <form method="POST" action="/rooms/<%= room.id %>/tenant" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Họ tên</label>
          <input name="full_name" class="input" value="<%= tenant?.full_name || '' %>" required placeholder="Nhập họ tên người thuê" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Số điện thoại</label>
            <input name="phone" class="input" value="<%= tenant?.phone || '' %>" placeholder="09xxxx" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Ngày bắt đầu</label>
            <input type="date" name="started_at" class="input" value="<%= tenant?.started_at || new Date().toISOString().slice(0,10) %>" />
          </div>
        </div>
        <div class="flex gap-3 pt-2">
          <button class="flex-1 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-medium transition-colors">Lưu người thuê</button>
          <% if (tenant) { %>
            <button formaction="/rooms/<%= room.id %>/tenant/end" formmethod="POST" class="px-4 py-2.5 rounded-xl border border-red-200 text-red-600 hover:bg-red-50 font-medium transition-colors">Kết thúc</button>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <div class="space-y-8">
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm border-t-4 border-t-indigo-500">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-lg font-bold text-slate-900">Nhập chỉ số điện nước</h2>
        <input type="month" id="month_ui" class="px-3 py-1.5 border border-slate-200 rounded-lg text-sm font-medium outline-none focus:border-indigo-500" required />
      </div>

      <form method="POST" action="/rooms/<%= room.id %>/meter" onsubmit="syncMonth()" class="space-y-5">
        <input type="hidden" name="yyyymm" id="yyyymm" value="<%= yyyymm %>" />
        
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <div class="font-semibold text-slate-800 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            Chỉ số Điện
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1">Số cũ <%= prevYyyymm ? `(${prevYyyymm})` : '' %></label>
              <input type="number" step="0.1" name="elec_start" value="<%= meter?.elec_start ?? prefill?.elec_start ?? '' %>" class="input bg-white" required />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1">Số mới</label>
              <input type="number" step="0.1" name="elec_end" value="<%= meter?.elec_end ?? '' %>" class="input bg-white border-indigo-200 focus:border-indigo-500" required />
            </div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <div class="font-semibold text-slate-800 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 14.66V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-5.34A5.84 5.84 0 0 1 2 12.28 5.71 5.71 0 0 1 8 8.16a5.7 5.7 0 0 1 6-4.16 5.7 5.7 0 0 1 6 4.16 5.71 5.71 0 0 1 6 4.12 5.84 5.84 0 0 1-2 2.38z"></path></svg>
            Chỉ số Nước
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1">Số cũ <%= prevYyyymm ? `(${prevYyyymm})` : '' %></label>
              <input type="number" step="0.1" name="water_start" value="<%= meter?.water_start ?? prefill?.water_start ?? '' %>" class="input bg-white" required />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1">Số mới</label>
              <input type="number" step="0.1" name="water_end" value="<%= meter?.water_end ?? '' %>" class="input bg-white border-indigo-200 focus:border-indigo-500" required />
            </div>
          </div>
        </div>

        <button class="w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold shadow-sm shadow-indigo-200 transition-colors">Cập nhật chỉ số</button>
      </form>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900 mb-4">Lịch sử hoá đơn</h2>
      <% if (invoices.length === 0) { %>
        <div class="text-sm text-slate-500 italic">Chưa có hoá đơn nào.</div>
      <% } else { %>
        <div class="space-y-3">
          <% invoices.forEach(inv => { %>
            <a href="/rooms/<%= room.id %>/invoice/<%= inv.yyyymm %>" class="flex items-center justify-between p-3 rounded-xl border border-slate-100 hover:border-indigo-200 hover:bg-indigo-50/50 transition-colors group">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-slate-100 group-hover:bg-indigo-100 flex items-center justify-center text-slate-500 group-hover:text-indigo-600 transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                </div>
                <div>
                  <div class="font-semibold text-slate-800">Tháng <%= inv.yyyymm.slice(4,6) %>/<%= inv.yyyymm.slice(0,4) %></div>
                  <div class="text-xs text-slate-500">Tạo: <%= new Date(inv.created_at).toLocaleDateString('vi-VN') %></div>
                </div>
              </div>
              <div class="font-bold text-slate-900 num"><%= inv.total %></div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
(function(){
  var yyyymm = "<%= yyyymm %>";
  var y = yyyymm.slice(0,4), m = yyyymm.slice(4,6);
  var el = document.getElementById('month_ui');
  if (el) {
    el.value = y + '-' + m;
    el.addEventListener('change', function(){
      var v = this.value; // YYYY-MM
      if (v) {
        var parts = v.split('-');
        var target = parts[0] + parts[1];
        window.location = '/rooms/<%= room.id %>?yyyymm=' + target;
      }
    });
  }
})();
function syncMonth(){
  // keep current yyyymm from hidden input
}

document.querySelectorAll('.num').forEach(function(n){
  var v = Number(n.textContent||0);
  n.textContent = new Intl.NumberFormat('vi-VN').format(v) + ' đ';
});
</script>
<%- include('partials/bottom') %>
