<%- include('partials/top', { title: 'Nhập điện nước hàng loạt', active: 'rooms' }) %>

<div class="mb-6 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Nhập điện nước hàng loạt</h1>
    <p class="text-slate-500 mt-1">Cập nhật chỉ số tiêu thụ cho tất cả các phòng trong tháng.</p>
  </div>
  <label class="flex items-center gap-2 bg-white px-4 py-2.5 rounded-xl shadow-sm border border-slate-200 cursor-pointer shrink-0">
    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
    <input type="month" id="month_ui" class="border-none bg-transparent font-semibold text-slate-800 outline-none" />
  </label>
</div>

<form method="POST" action="/meters" class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
  <input type="hidden" name="yyyymm" id="yyyymm" value="<%= yyyymm %>" />

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse min-w-[760px]">
      <thead>
        <tr class="bg-slate-50/80">
          <th rowspan="2" class="py-4 px-6 text-xs font-semibold text-slate-500 uppercase tracking-wide align-middle border-b border-slate-200">Phòng</th>
          <th colspan="2" class="py-3 px-4 border-l border-b border-slate-200">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </span>
              <span class="font-bold text-slate-800">Chỉ số Điện</span>
              <span class="text-xs text-slate-400 font-normal">(kWh)</span>
            </div>
          </th>
          <th colspan="2" class="py-3 px-4 border-l border-b border-slate-200">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 14.66V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-5.34A5.84 5.84 0 0 1 2 12.28 5.71 5.71 0 0 1 8 8.16a5.7 5.7 0 0 1 6-4.16 5.7 5.7 0 0 1 6 4.16 5.71 5.71 0 0 1 6 4.12 5.84 5.84 0 0 1-2 2.38z"/></svg>
              </span>
              <span class="font-bold text-slate-800">Chỉ số Nước</span>
              <span class="text-xs text-slate-400 font-normal">(m³)</span>
            </div>
          </th>
        </tr>
        <tr class="bg-slate-50/80 text-xs font-medium text-slate-400">
          <th class="py-2 px-4 border-l border-b border-slate-200 font-medium">Cũ</th>
          <th class="py-2 px-4 border-b border-slate-200 font-medium">Mới</th>
          <th class="py-2 px-4 border-l border-b border-slate-200 font-medium">Cũ</th>
          <th class="py-2 px-4 border-b border-slate-200 font-medium">Mới</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% rooms.forEach(room => {
            const meter = metersByRoom[room.id];
            const prev = prevMetersByRoom[room.id];
            const isOccupied = occupiedRooms.has(room.id);
            const elec_start_val = meter?.elec_start ?? prev?.elec_end ?? '';
            const water_start_val = meter?.water_start ?? prev?.water_end ?? '';
            const oldCls = 'w-full px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 text-slate-600 text-sm outline-none focus:border-indigo-400 focus:bg-white transition-colors';
            const newCls = 'w-full px-3 py-2 rounded-lg border border-slate-200 bg-white text-slate-800 text-sm font-medium outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-colors';
            const offCls = 'w-full px-3 py-2 rounded-lg border border-slate-100 bg-slate-100 text-slate-300 text-sm text-center outline-none cursor-not-allowed';
        %>
        <tr class="hover:bg-slate-50/50 transition-colors">
          <td class="py-3 px-6 align-middle">
            <div class="font-bold text-slate-800 flex items-center gap-2">
              <span><%= room.name %></span>
              <% if (!isOccupied) { %>
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-rose-50 text-rose-500 border border-rose-100">Trống</span>
              <% } %>
            </div>
            <div class="text-xs text-slate-400 mt-0.5"><%= tenantsByRoom[room.id] || '—' %></div>
          </td>

          <% if (isOccupied) { %>
            <td class="py-3 px-4 border-l border-slate-100">
              <input type="number" step="0.1" name="elec_start_<%= room.id %>" value="<%= elec_start_val %>" class="<%= oldCls %>" placeholder="Số cũ" />
            </td>
            <td class="py-3 px-4">
              <input type="number" step="0.1" name="elec_end_<%= room.id %>" value="<%= meter?.elec_end ?? '' %>" class="meter-new <%= newCls %>" data-room="<%= room.id %>" placeholder="Nhập số mới" />
            </td>
            <td class="py-3 px-4 border-l border-slate-100">
              <input type="number" step="0.1" name="water_start_<%= room.id %>" value="<%= water_start_val %>" class="<%= oldCls %>" placeholder="Số cũ" />
            </td>
            <td class="py-3 px-4">
              <input type="number" step="0.1" name="water_end_<%= room.id %>" value="<%= meter?.water_end ?? '' %>" class="meter-new <%= newCls %>" data-room="<%= room.id %>" placeholder="Nhập số mới" />
            </td>
          <% } else { %>
            <td class="py-3 px-4 border-l border-slate-100">
              <input type="number" value="<%= elec_start_val %>" class="<%= offCls %>" placeholder="-" disabled />
            </td>
            <td class="py-3 px-4">
              <input type="text" class="<%= offCls %>" placeholder="-" disabled />
            </td>
            <td class="py-3 px-4 border-l border-slate-100">
              <input type="number" value="<%= water_start_val %>" class="<%= offCls %>" placeholder="-" disabled />
            </td>
            <td class="py-3 px-4">
              <input type="text" class="<%= offCls %>" placeholder="-" disabled />
            </td>
          <% } %>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="p-4 sm:px-6 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
    <div class="text-sm text-slate-500 flex items-center gap-2">
      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Đã nhập <span id="filled-count" class="font-semibold text-slate-700">0</span>/<%= occupiedCount %> phòng có người thuê.
    </div>
    <div class="flex items-center gap-2">
      <a href="/" class="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-white font-medium transition-colors">Hủy</a>
      <button class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-sm shadow-indigo-200 transition-colors flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
        Lưu tất cả chỉ số
      </button>
    </div>
  </div>
</form>

<script>
(function(){
  var yyyymm = "<%= yyyymm %>";
  var y = yyyymm.slice(0,4), m = yyyymm.slice(4,6);
  var el = document.getElementById('month_ui');
  if (el) {
    el.value = y + '-' + m;
    el.addEventListener('change', function(){
      var v = this.value; // YYYY-MM
      if (v) {
        var parts = v.split('-');
        window.location = '/meters?yyyymm=' + parts[0] + parts[1];
      }
    });
  }

  // Bộ đếm "đã nhập X/Y": một phòng được tính là xong khi cả 2 ô "Mới"
  // (điện + nước) đều đã điền.
  var inputs = Array.prototype.slice.call(document.querySelectorAll('.meter-new'));
  function recount(){
    var rooms = {};
    inputs.forEach(function(inp){
      var r = inp.dataset.room;
      if (!rooms[r]) rooms[r] = { total: 0, filled: 0 };
      rooms[r].total++;
      if (inp.value.trim() !== '') rooms[r].filled++;
    });
    var done = 0;
    Object.keys(rooms).forEach(function(r){
      if (rooms[r].total > 0 && rooms[r].filled === rooms[r].total) done++;
    });
    var badge = document.getElementById('filled-count');
    if (badge) badge.textContent = done;
  }
  inputs.forEach(function(i){ i.addEventListener('input', recount); });
  recount();
})();
</script>

<%- include('partials/bottom') %>
