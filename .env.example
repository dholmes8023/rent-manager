# Bắt buộc: chuỗi kết nối tới PostgreSQL.
# Ví dụ local: postgres://postgres:postgres@localhost:5432/rent_manager
# Ví dụ Render/Railway: postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=

# Cổng HTTP (mặc định 3000)
PORT=3000

# Môi trường: development | production
NODE_ENV=development
